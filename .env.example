# MarketCatalystUI — environment template. Copy to .env.local for local dev.
# Every value containing PLACEHOLDER (or an example.com address) must be
# replaced before production; see MarketCatalystBackEnd/docs/PLACEHOLDERS.md.

# Backend origin for local dev (ignored on deployed hosts, which use same-origin).
NEXT_PUBLIC_BACKEND_URL=http://localhost:4400

# Admin account shown the admin console (must match backend ADMIN_EMAIL).
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Public pricing page on the marketing site (Manage Plan "See planned pricing").
NEXT_PUBLIC_PRICING_URL=https://marketcatalyst.ai/#pricing

# Stripe.js, for 3-D Secure confirmation once the Stripe adapter is built.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=__PLACEHOLDER__

# Local walkthroughs only: Firebase Auth emulator host (never set in production builds).
# NEXT_PUBLIC_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Payment methods offered by the Payment Element (Apple Pay / Google Pay ride on "card").
# Must match the backend's STRIPE_PAYMENT_METHOD_TYPES. Add ",paypal" only if your
# Stripe account supports it; never crypto or UPI.
NEXT_PUBLIC_STRIPE_PAYMENT_METHOD_TYPES=card,link
