rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Market Intelligence Platform — Firestore Security Rules
// Version: 1.0
//
// KEY DESIGN DECISIONS:
//
//  1. Subscription tier is stored as a Firebase Auth custom claim ({ tier: "pro" })
//     set by the backend (Firebase Admin SDK) whenever Stripe webhook fires.
//     Rules read request.auth.token.tier — zero extra Firestore reads per rule eval.
//
//  2. ALL market-data collections (news, earnings, analyst_actions, etc.) are
//     READ-ONLY for clients. Every write comes from ECS workers via Admin SDK,
//     which bypasses these rules entirely.
//
//  3. User sub-collections are isolated to the owning uid — no cross-user reads.
//
//  4. Field-level gating (e.g. aiNote on analyst_actions for Pro+ only) is
//     enforced at the API layer (Fastify), not here. Firestore rules cannot
//     strip individual fields from a document.
//
//  5. Watchlist 5-ticker limit for Free tier is enforced at the API layer.
//     Firestore rules cannot count sub-collection documents cheaply.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────

    // User must be signed in via Firebase Authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Request comes from the document owner
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Plan from the `plan` custom claim, set only by the backend's billing
    // event handler (catalog ids: free | starter | pro | elite).
    function plan() {
      return request.auth.token.get('plan', 'free');
    }

    function planAtLeast(minimum) {
      return (minimum == 'starter' && plan() in ['starter', 'pro', 'elite'])
          || (minimum == 'pro' && plan() in ['pro', 'elite'])
          || (minimum == 'elite' && plan() == 'elite');
    }

    // The SUBSCRIPTIONS_ENABLED release switch (admin toggle, Firestore
    // override). Off or unset → no plan gating, today's behaviour.
    function subscriptionsEnabled() {
      return exists(/databases/$(database)/documents/feature_flags/default)
          && get(/databases/$(database)/documents/feature_flags/default).data.get('flags', {}).get('SUBSCRIPTIONS_ENABLED', false) == true;
    }

    // Signed in, and on `minimum` or above while subscriptions are live.
    function canReadOnPlan(minimum) {
      return isAuthenticated() && (!subscriptionsEnabled() || planAtLeast(minimum));
    }

    // Investor-profile fields a user may write on their own users/{uid} doc.
    // Mirrors PROFILE_FIELDS in MarketCatalystBackEnd/src/user-data/profile.dto.ts.
    // Everything else on that doc — uid, email, tier, currentPlan,
    // subscription*, featureFlags, stripe* — is server-owned (Admin SDK only;
    // billing fields only via the Stripe webhook). An allowlist, not a denylist:
    // a new server-owned field is protected without touching these rules.
    function profileFields() {
      return ['profile_image', 'name', 'mobileNumber', 'age', 'incomeRange',
              'investmentExperience', 'investmentGoals', 'riskTolerance',
              'investmentHorizon', 'currentPortfolioValue',
              'preferredAssetClasses', 'updatedAt'];
    }

    // An update touches investor-profile fields only.
    function onlyProfileFieldsChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(profileFields());
    }


    // ═════════════════════════════════════════════════════════════════════════
    // MARKET DATA COLLECTIONS — server writes only, tier-gated client reads
    // ═════════════════════════════════════════════════════════════════════════

    // Company reference data — all authenticated users
    match /companies/{ticker} {
      allow read:  if isAuthenticated();
      allow write: if false;  // Admin SDK only
    }

    // Full US ticker universe (name/exchange/type/active/cik only — no
    // fundamentals; see companies/{ticker} for that) — all authenticated users
    match /tickers/{ticker} {
      allow read:  if isAuthenticated();
      allow write: if false;  // Admin SDK only
    }

    // Historical daily OHLCV bars — append-only, one immutable doc per
    // (ticker, date). Feeds Stock Detail's chart; a future RS-Rating
    // computation depends on this accumulating history first.
    match /ohlcv_bars/{barId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Earnings calendar + actuals — all authenticated users
    match /earnings_events/{eventId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // AI-generated earnings summaries — Starter (earnings detail)
    match /earnings_summaries/{summaryId} {
      allow read:  if canReadOnPlan('starter');
      allow write: if false;
    }

    // News feed — all authenticated users
    match /news/{newsId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Analyst upgrades/downgrades — all authenticated users
    // (aiNote field stripped by API middleware for Free users)
    match /analyst_actions/{actionId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Macro/economic calendar — all authenticated users
    match /macro_events/{eventId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Market movers snapshots — all authenticated users
    match /market_movers/{moverId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Append-only history of market_movers — one immutable doc per
    // (date, direction, ticker), never overwritten by a later sync.
    match /market_movers_history/{docId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Options flow (unusual activity) — Pro
    match /options_flow/{flowId} {
      allow read:  if canReadOnPlan('pro');
      allow write: if false;
    }

    // Block trades — Pro
    match /block_trades/{tradeId} {
      allow read:  if canReadOnPlan('pro');
      allow write: if false;
    }

    // 13F fund holdings
    // Covers fund document, filings sub-collection, and positions sub-sub-collection
    // Starter (13F & insider)
    match /fund_holdings/{cik} {
      allow read:  if canReadOnPlan('starter');
      allow write: if false;

      match /filings/{filingId} {
        allow read:  if canReadOnPlan('starter');
        allow write: if false;

        match /positions/{ticker} {
          allow read:  if canReadOnPlan('starter');
          allow write: if false;
        }
      }
    }

    // Story stocks — Pro
    match /story_stocks/{storyId} {
      allow read:  if canReadOnPlan('pro');
      allow write: if false;
    }

    // EOD and weekly recaps — Free (shown on every user's dashboard)
    match /recaps/{recapId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Live market indices (S&P 500, Nasdaq, VIX, yields, commodities, DXY, etc.)
    match /market_indices/{symbol} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Append-only history of market_indices — one immutable doc per
    // (date, symbol), never overwritten by a later sync.
    match /market_indices_history/{docId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Sector heatmap / theme performance
    match /sectors/{sectorId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Append-only history of sectors — one immutable doc per (date, sector),
    // never overwritten by a later sync.
    match /sectors_history/{docId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // IPO calendar (recent + pipeline)
    match /ipos/{ipoId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Dividend calendar
    match /dividends/{ticker} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Form 4 insider transactions (individual buy/sell rows)
    match /insider_transactions/{id} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // Options chain reference data — real strikes/expirations + delayed
    // last close/volume per contract (Polygon). Bid/ask, IV, greeks, and
    // open interest are NOT here — confirmed 403 on the current Polygon
    // plan; options.tsx's main chain table stays simulated for those.
    match /options_chains/{ticker} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }


    // ═════════════════════════════════════════════════════════════════════════
    // USER COLLECTIONS — scoped strictly to owning uid
    // ═════════════════════════════════════════════════════════════════════════

    match /users/{uid} {
      // Only the user can read their own profile
      allow read: if isOwner(uid);

      // Create: the backend creates this doc (PATCH /api/profile, Admin SDK)
      // with server-set plan defaults. A client create may carry only profile
      // fields plus its own uid, its own verified auth email and createdAt —
      // never a plan, subscription, Stripe or feature-flag field.
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasAll(['uid', 'createdAt'])
                    && request.resource.data.keys()
                         .hasOnly(profileFields().concat(['uid', 'email', 'createdAt']))
                    && request.resource.data.uid == request.auth.uid
                    && (!('email' in request.resource.data)
                        || request.resource.data.email == request.auth.token.email);

      // Update: investor-profile fields only (allowlist).
      allow update: if isOwner(uid) && onlyProfileFieldsChange();

      // Hard deletes blocked — use deletedAt soft-delete via API
      allow delete: if false;


      // ── Portfolios ──────────────────────────────────────────────────────────
      match /portfolios/{portfolioId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasAll(['name', 'createdAt']);
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);

        // Holdings inside a portfolio
        match /holdings/{ticker} {
          allow read:   if isOwner(uid);
          allow create: if isOwner(uid)
                        && request.resource.data.keys().hasAll(['ticker', 'shares', 'addedAt']);
          allow update: if isOwner(uid);
          allow delete: if isOwner(uid);
        }
      }

      // ── Watchlists ─────────────────────────────────────────────────────────
      // Tier limit (Free = max 5 tickers per list) enforced at API layer.
      match /watchlists/{watchlistId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasAll(['name', 'tickers', 'createdAt'])
                      && request.resource.data.tickers is list;
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Alert Rules ────────────────────────────────────────────────────────
      // 12 alert types available; which types are active depends on tier
      // (enforced at API layer, not here).
      match /alerts/{alertId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.keys().hasAll(['type', 'deliveryChannels', 'enabled', 'createdAt'])
                      && request.resource.data.type in [
                           'earnings', 'analyst', 'volume', 'price', '52wk_breakout',
                           'peer_move', 'macro_event', 'block_trade', '13f_filing',
                           'group_rs_rank', 'options_unusual', 'price_target_hit'
                         ]
                      && request.resource.data.deliveryChannels is list;
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Notifications ──────────────────────────────────────────────────────
      // Created by server (alert engine via Admin SDK).
      // Users can only mark as read (update 'read' field) or delete.
      match /notifications/{notificationId} {
        allow read:   if isOwner(uid);

        // Client can only flip read → true; all other fields are server-managed
        allow update: if isOwner(uid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                      && request.resource.data.read == true;

        // Clients can dismiss (delete) their own notifications
        allow delete: if isOwner(uid);

        // Creates come from Admin SDK only
        allow create: if false;
      }

    } // end /users/{uid}


    // ═════════════════════════════════════════════════════════════════════════
    // USER SETTINGS — per-user preferences (dark mode, etc.)
    // ═════════════════════════════════════════════════════════════════════════

    match /settings/{uid} {
      allow read, write: if isOwner(uid);
    }



    // ═════════════════════════════════════════════════════════════════════════
    // BILLING — backend-only. Written by the billing event handler (Admin SDK,
    // which bypasses rules) and read through the API. No client access at all.
    // ═════════════════════════════════════════════════════════════════════════
    match /customers/{d=**}             { allow read, write: if false; }
    match /subscriptions/{d=**}         { allow read, write: if false; }
    match /payments/{d=**}              { allow read, write: if false; }
    match /subscription_events/{d=**}   { allow read, write: if false; }
    match /promo_codes/{d=**}           { allow read, write: if false; }
    match /promo_redemptions/{d=**}     { allow read, write: if false; }
    match /promo_attempts/{d=**}        { allow read, write: if false; }
    match /retention_offers/{d=**}      { allow read, write: if false; }
    match /stripe_events/{d=**}         { allow read, write: if false; }
    match /checkout_sessions/{d=**}     { allow read, write: if false; }
    match /launch_offers/{d=**}         { allow read, write: if false; }
    match /admin_audit/{d=**}           { allow read, write: if false; }
    match /fake_billing_customers/{d=**}         { allow read, write: if false; }
    match /fake_billing_subscriptions/{d=**}     { allow read, write: if false; }
    match /fake_billing_invoices/{d=**}          { allow read, write: if false; }
    match /fake_billing_checkouts/{d=**}         { allow read, write: if false; }
    match /fake_billing_actions/{d=**}           { allow read, write: if false; }
    match /fake_billing_events/{d=**}            { allow read, write: if false; }
    match /fake_billing_portal_sessions/{d=**}   { allow read, write: if false; }
    match /fake_billing_promotions/{d=**}        { allow read, write: if false; }

    // ═════════════════════════════════════════════════════════════════════════
    // DENY ALL — catch-all for any path not explicitly matched above
    // ═════════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
